        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response có bookingid\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"bookingid\");",
                  "    pm.expect(json.bookingid).to.be.a(\"number\");",
                  "});",
                  "",
                  "pm.test(\"Thông tin booking đúng\", function () {",
                  "    const b = pm.response.json().booking;",
                  "    pm.expect(b.firstname).to.eql(\"Mai\");",
                  "    pm.expect(b.lastname).to.eql(\"Van\");",
                  "    pm.expect(b.totalprice).to.eql(150);",
                  "    pm.expect(b.bookingdates.checkin).to.eql(\"2026-11-01\");",
                  "    pm.expect(b.bookingdates.checkout).to.eql(\"2026-11-05\");",
                  "});",
                  "",
                  "pm.environment.set(\"bookingid\", pm.response.json().bookingid);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"Mai\",\n  \"lastname\": \"Van\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-11-01\",\n    \"checkout\": \"2026-11-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Dữ liệu khớp booking đã tạo\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.firstname).to.eql(\"Mai\");",
                  "    pm.expect(json.lastname).to.eql(\"Van\");",
                  "    pm.expect(json.totalprice).to.eql(150);",
                  "    pm.expect(json.depositpaid).to.eql(true);",
                  "    pm.expect(json.bookingdates.checkin).to.eql(\"2026-11-01\");",
                  "    pm.expect(json.bookingdates.checkout).to.eql(\"2026-11-05\");",
                  "});",
                  "",
                  "pm.test(\"Response time dưới 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking/{{bookingid}}",
